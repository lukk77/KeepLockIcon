#import <UIKit/UIKit.h>

// Объявляем класс иконки, чтобы компилятор знал о методах
@interface SBUIProudLockIconView : UIView
// Метод установки состояния: 1 = Locked, 2 = Unlocked (значения могут варьироваться, но обычно это так)
- (void)setState:(long long)arg1 animated:(BOOL)arg2;
@end

%hook SBUIProudLockIconView

// Перехватываем установку состояния замка
- (void)setState:(long long)state animated:(BOOL)animated {
    
    // Если система пытается установить состояние "2" (Разблокировано),
    // мы подменяем его на "1" (Заблокировано).
    if (state == 2) {
        state = 1;
    }
    
    // Вызываем оригинальный метод с (возможно) подмененным состоянием
    %orig(state, animated);
}

// Дополнительно: Если проблема именно в исчезновении (прозрачности),
// можно запретить скрытие иконки.
// Раскомментируйте код ниже, если иконка все равно пропадает.

/*
- (void)setAlpha:(double)alpha {
    // Если система пытается сделать иконку полностью прозрачной (0.0),
    // и это происходит на экране блокировки, принудительно ставим 1.0.
    if (alpha == 0.0) {
        alpha = 1.0; 
    }
    %orig(alpha);
}
*/

%end
