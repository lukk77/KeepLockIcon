#import <UIKit/UIKit.h>

// Класс, который управляет представлением значка блокировки
@interface SBLockScreenView : UIView
// Метод, который, вероятно, устанавливает видимость значка
- (void)_setShowingLockStatusBarIcon:(BOOL)arg1;
@end

// Класс, который отвечает за индикатор Face ID на Lock Screen
// Его часто называют "Mesa" (кодовое имя Face ID в Apple)
@interface SBLockScreenMesaFaceSuccessView : UIView
- (void)_dismiss; // Метод, который вызывает исчезновение индикатора успеха
@end

%hook SBLockScreenMesaFaceSuccessView

// Перехватываем метод _dismiss, который отвечает за исчезновение индикатора успеха Face ID.
// Если мы заблокируем вызов оригинального метода, индикатор (включая открытый замок) останется.
- (void)_dismiss {
    // Вместо вызова оригинального метода (%orig) мы просто ничего не делаем.
    // Это предотвращает исчезновение значка открытого замка/индикатора успеха Face ID.
    
    // ВНИМАНИЕ: Если этот метод также отвечает за освобождение ресурсов или 
    // другую логику, могут возникнуть мелкие проблемы, но для данной цели это самое простое решение.
    
    // НЕ ВЫЗЫВАЕМ %orig;
}

%end


// Дополнительный Хук: Попытка предотвратить скрытие самого значка 
// (На случай, если LockScreenView пытается его спрятать независимо)
%hook SBLockScreenView

// Перехватываем метод, который управляет видимостью значка
- (void)_setShowingLockStatusBarIcon:(BOOL)arg1 {
    // Если система пытается скрыть значок (arg1 == NO), мы заставляем ее показать его (arg1 = YES).
    // Это гарантирует, что значок замка остается видимым после Face ID.
    if (arg1 == NO) {
        // Мы принудительно устанавливаем его в YES, чтобы сохранить значок
        // Нам нужно убедиться, что он был открытым (успешный Face ID),
        // но, поскольку _dismiss уже предотвращен, значок должен быть в состоянии успеха.
        arg1 = YES;
    }
    
    // Вызываем оригинальный метод с нашей (возможно, измененной) аргументом
    %orig(arg1);
}

%end
